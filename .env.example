# Local configuration for the live API smoke tests.
#
# Copy to .env and fill in a real key to run them:
#     cp .env.example .env
#     just live
#
# .env is gitignored. Never commit a real credential.
# Every other test in the suite is hermetic and needs none of this.
#
# Real environment variables take precedence over this file, so
# `SUPERMETRICS_API_KEY=... just live` still works.

# Supermetrics API key. Get one at https://supermetrics.com/account/api
SUPERMETRICS_API_KEY=api_replace_me

# Optional. Point the live tests at a non-production environment.
SUPERMETRICS_BASE_URL=https://api.supermetrics.com
